# Copy this file to secrets.yaml and fill in your values.
# NEVER commit secrets.yaml to version control.

# Gemini API key for AI-powered features
GEMINI_API_KEY: "your_gemini_api_key_here"

# Private key for transaction signing
# For local anvil development, use the default anvil private key:
# CRE_ETH_PRIVATE_KEY: "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
CRE_ETH_PRIVATE_KEY: "your_private_key_here"
