# Network: "local" for anvil, "base-sepolia" for testnet
NETWORK=local

# RPC URL (anvil default or alchemy/infura for testnet)
RPC_URL=http://127.0.0.1:8545

# MiniMarket contract address (set after deployment)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Block to start indexing from (1 for fresh anvil deployment)
START_BLOCK=1
